[Unit]
Description=MADO HR API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=madohr
WorkingDirectory=/opt/mado_hr/backend
EnvironmentFile=/etc/mado-hr/mado-hr.env
# --proxy-headers + доверие только nginx на 127.0.0.1: реальный IP клиента для ограничения попыток входа.
# Один процесс (без --workers): счётчик попыток хранится в памяти.
ExecStart=/opt/mado_hr/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
