BOT_TOKEN=
ADMIN_IDS=
ADMIN_CHAT_ID=
DATABASE_URL=postgresql+asyncpg://mado_user:CHANGE_ME@localhost:5432/mado_hr
LOG_PATH=/var/log/mado-jbot/bot.log
LOG_LEVEL=INFO
# Mini App / API
WEBAPP_URL=https://hr.example.com
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=
# Документы кандидатов: каталог вне веб-директории, доступный на запись пользователю сервиса
UPLOAD_DIR=/var/lib/mado-hr/uploads
# Проверка напоминаний, секунд (не меньше 60)
REMINDER_INTERVAL_SECONDS=300
# Optional integrations
# Автоотчёт по интервью. Модель можно заменить на любую, доступную в вашем аккаунте OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
GOOGLE_SHEETS_CREDENTIALS_PATH=
